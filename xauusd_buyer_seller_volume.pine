//@version=6
// =============================================================================
// XAUUSD Buyer / Seller Volume (ESTIMATE) - companion panel
// -----------------------------------------------------------------------------
// Spot gold has no central exchange. TradingView XAUUSD feeds give TICK volume
// (number of price updates from one provider), not ounces traded and not real
// buyer/seller orders. This panel SPLITS each candle's volume by where it
// closed in its range: close at the high = 100% "buyers", at the low = 100%
// "sellers". It uses the same formula as the Easy strategy's pressure filter.
// =============================================================================
indicator("XAUUSD Buyer/Seller Volume (estimate)", shorttitle = "XAU Buy/Sell Vol", overlay = false, format = format.volume)

len = input.int(20, "Pressure length (bars)", minval = 2)

rng      = high - low
buyFrac  = rng > 0 ? (close - low) / rng : 0.5
vol      = nz(volume)
buyVol   = vol * buyFrac
sellVol  = vol - buyVol
buySum   = math.sum(buyVol, len)
sellSum  = math.sum(sellVol, len)
buyPct   = buySum + sellSum > 0 ? buySum / (buySum + sellSum) * 100 : 50.0
delta    = buySum - sellSum

plot(buyVol, "Buyer volume (est.)", color.new(color.teal, 20), style = plot.style_columns)
plot(-sellVol, "Seller volume (est.)", color.new(color.red, 20), style = plot.style_columns)
plot(delta / len, "Avg delta (buyers - sellers)", color.new(color.yellow, 0), 2)
hline(0, "Zero", color.new(color.gray, 50))

var table t = table.new(position.top_right, 1, 2, bgcolor = color.new(#131722, 10))
if barstate.islast
    table.cell(t, 0, 0, "Last " + str.tostring(len) + " bars: buyers " + str.tostring(buyPct, "#") + "% / sellers " + str.tostring(100 - buyPct, "#") + "%",
         text_color = color.white, bgcolor = buyPct > 55 ? color.new(color.teal, 40) : buyPct < 45 ? color.new(color.red, 40) : color.new(color.gray, 60), text_size = size.small)
    table.cell(t, 0, 1, vol > 0 ? "Estimate from " + syminfo.volumetype + " volume - not real orders" : "This feed has no volume", text_color = color.gray, text_size = size.tiny)
