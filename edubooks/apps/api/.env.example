# Owner role: runs migrations & seed (owns tables).
DATABASE_OWNER_URL=postgres://edubooks:edubooks@localhost:5432/edubooks
# App role: used at runtime. Not table owner, NOBYPASSRLS -> Row-Level Security is enforced.
DATABASE_URL=postgres://edubooks_app:edubooks_app@localhost:5432/edubooks
PORT=4000
# Secret for signing short-lived file URLs. CHANGE IN PRODUCTION (32+ random chars).
FILE_URL_SECRET=dev-only-change-me-0123456789abcdef
COOKIE_SECURE=0
# Storage: "local" (private folder) or "s3" (any S3-compatible: AWS, R2, MinIO)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_BUCKET=edubooks-private
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=300
# Malware scanning via clamd (optional): CLAMAV_HOST=localhost CLAMAV_PORT=3310
# Require a successful scan before accepting files (production):
# REQUIRE_MALWARE_SCAN=1
