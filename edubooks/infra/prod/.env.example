# Copy to the repository root as .env and fill in. Generate secrets with:  openssl rand -base64 33
DOMAIN=lms.example.com
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Signs short-lived file links (32+ random characters)
FILE_URL_SECRET=

# Files: "local" (Docker volume) or "s3" (AWS S3, Cloudflare R2, MinIO…)
STORAGE_DRIVER=local
# S3_BUCKET=  S3_REGION=auto  S3_ENDPOINT=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=300

# Malware scanning: start with  --profile clamav  and set
# CLAMAV_HOST=clamav
# REQUIRE_MALWARE_SCAN=1

# AI: offline (no model, template drafts) | openai-compatible (self-hosted Ollama/vLLM) | anthropic
AI_PROVIDER=offline
# AI_BASE_URL=http://ollama-host:11434/v1
# AI_MODEL=qwen2.5:7b-instruct
# AI_API_KEY=
AI_MONTHLY_REQUESTS_PER_SCHOOL=1000

SESSION_IDLE_MINUTES=720
BACKUP_KEEP_DAYS=14
# BACKUP_HOST_DIR=/var/backups/edubooks
